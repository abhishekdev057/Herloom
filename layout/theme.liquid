<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ivory }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- liquid
      assign title_suffix = ''
      unless page_title contains shop.name
        assign title_suffix = ' — ' | append: shop.name
      endunless
    -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} — {{ 'general.meta.tags' | t: tags: current_tags.join(', ') }}{% endif -%}
      {%- if current_page != 1 %} — {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {{- title_suffix -}}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'fonts' %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
    {% render 'json-ld' %}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}" data-template="{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    {% render 'search-drawer' %}
    {%- unless template.name == 'index' -%}{% render 'newsletter-slide-in' %}{%- endunless -%}
    <div class="toast-region" aria-live="polite" role="status" data-toasts></div>

    <script>
      window.Herloom = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        strings: {
          added: {{ 'cart.added' | t | json }},
          error: {{ 'cart.error' | t | json }},
          wishlistAdded: {{ 'wishlist.added' | t | json }},
          wishlistRemoved: {{ 'wishlist.removed' | t | json }},
          selectSize: {{ 'product.select_size' | t | json }},
          soldOut: {{ 'product.sold_out' | t | json }},
          addToBag: {{ 'product.add_to_bag' | t | json }}
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
  </body>
</html>
