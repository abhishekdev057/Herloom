{%- comment -%}
  Full-screen campaign hero. Video (Shopify-hosted) with poster fallback; separate
  mobile media. Autoplay disabled for prefers-reduced-motion and Save-Data (theme.js).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign poster = s.image
  assign poster_m = s.image_mobile | default: s.image
-%}
<section class="hero hero--{{ s.height }} hero--align-{{ s.align }}" data-hero>
  <div class="hero__media">
    {%- if s.video != blank -%}
      <video class="hero__video hero__video--desktop" muted loop playsinline preload="none"
        {% if poster %}poster="{{ poster | image_url: width: 1920 }}"{% endif %} data-hero-video aria-hidden="true">
        {%- for source in s.video.sources -%}
          {%- if source.format == 'mp4' or source.format == 'webm' -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endif -%}
        {%- endfor -%}
      </video>
    {%- endif -%}
    {%- if s.video_mobile != blank -%}
      <video class="hero__video hero__video--mobile" muted loop playsinline preload="none"
        {% if poster_m %}poster="{{ poster_m | image_url: width: 1080 }}"{% endif %} data-hero-video aria-hidden="true">
        {%- for source in s.video_mobile.sources -%}
          {%- if source.format == 'mp4' or source.format == 'webm' -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endif -%}
        {%- endfor -%}
      </video>
    {%- endif -%}

    <picture class="hero__poster">
      {%- if s.image_mobile != blank -%}
        <source media="(max-width: 767px)" srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w, {{ s.image_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
      {%- endif -%}
      {%- if poster != blank -%}
        {%- assign hero_alt = poster.alt | default: s.heading | escape -%}
        {{ poster | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </picture>
    <div class="hero__scrim" style="--scrim: {{ s.scrim | divided_by: 100.0 }}"></div>
  </div>

  <div class="hero__content page-width">
    {%- if s.label != blank -%}<p class="meta hero__label">{{ s.label }}</p>{%- endif -%}
    {%- if s.heading != blank -%}
      <h1 class="display hero__heading">{{ s.heading }}</h1>
    {%- else -%}
      <h1 class="visually-hidden">{{ shop.name }}</h1>
    {%- endif -%}
    {%- if s.subheading != blank -%}<p class="hero__sub">{{ s.subheading }}</p>{%- endif -%}
    <div class="hero__ctas">
      {%- if s.cta1_label != blank -%}<a href="{{ s.cta1_link | default: routes.all_products_collection_url }}" class="btn btn--light">{{ s.cta1_label }}</a>{%- endif -%}
      {%- if s.cta2_label != blank -%}<a href="{{ s.cta2_link | default: '#' }}" class="btn btn--ghost-light">{{ s.cta2_label }}</a>{%- endif -%}
    </div>
  </div>

  {%- if s.video != blank or s.video_mobile != blank -%}
    <button type="button" class="hero__pause icon-btn" data-hero-toggle aria-pressed="false" aria-label="{{ 'accessibility.pause_video' | t }}">
      <span class="hero__icon-pause">{% render 'icon', name: 'pause' %}</span>
      <span class="hero__icon-play" hidden>{% render 'icon', name: 'play' %}</span>
    </button>
  {%- endif -%}
  {%- if s.scroll_cue -%}<span class="hero__cue meta" aria-hidden="true">{{ 'general.scroll' | t }}</span>{%- endif -%}
</section>

{% schema %}
{
  "name": "Hero — campaign",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Desktop video (6–12s, ≤5MB)" },
    { "type": "video", "id": "video_mobile", "label": "Mobile video (portrait)" },
    { "type": "image_picker", "id": "image", "label": "Poster / fallback image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Poster / fallback image (mobile)" },
    { "type": "range", "id": "scrim", "label": "Bottom scrim strength", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 30 },
    { "type": "select", "id": "height", "label": "Height", "default": "full", "options": [ { "value": "full", "label": "Full screen" }, { "value": "large", "label": "85% screen" } ] },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "label", "label": "Campaign label", "default": "The Summer Edit — Collection 01" },
    { "type": "text", "id": "heading", "label": "Headline (large)", "default": "Herloom" },
    { "type": "text", "id": "subheading", "label": "Supporting line", "default": "Shirts, perfected. For every version of her." },
    { "type": "select", "id": "align", "label": "Text position", "default": "bottom-left", "options": [ { "value": "bottom-left", "label": "Bottom left" }, { "value": "center", "label": "Centre" }, { "value": "bottom-center", "label": "Bottom centre" } ] },
    { "type": "text", "id": "cta1_label", "label": "Primary button", "default": "Shop New In" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button", "default": "View Campaign" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "checkbox", "id": "scroll_cue", "label": "Show scroll cue", "default": true }
  ],
  "presets": [{ "name": "Hero — campaign" }]
}
{% endschema %}
