<section class="section auth">
  <div class="page-width auth__inner">
    <h1 class="h1">{{ 'customer.reset.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'auth__form' -%}
      {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="ResetPass">{{ 'customer.password' | t }}</label><input class="input" id="ResetPass" type="password" name="customer[password]" autocomplete="new-password"></div>
      <div class="field"><label for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input class="input" id="ResetConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password"></div>
      <button class="btn btn--full">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
