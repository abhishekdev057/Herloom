{%- liquid
  assign is_transparent = false
  if template.name == 'index' and section.settings.transparent_home
    assign is_transparent = true
  endif
  assign menu = section.settings.menu
  assign mega_title = section.settings.mega_link_title | downcase | strip
-%}
<header class="header{% if is_transparent %} header--transparent{% endif %}" data-header {% if is_transparent %}data-transparent{% endif %}>
  <div class="header__inner page-width">
    <div class="header__left">
      <button class="icon-btn header__burger" type="button" data-drawer-open="menu" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'accessibility.menu' | t }}">
        {% render 'icon', name: 'menu' %}
      </button>
      <nav class="header__nav" aria-label="{{ 'accessibility.primary_nav' | t }}">
        <ul role="list" class="header__links">
          {%- for link in linklists[menu].links -%}
            {%- assign t = link.title | downcase | strip -%}
            {%- if t == mega_title and section.blocks.size > 0 -%}
              <li class="header__item has-mega" data-mega>
                <button type="button" class="header__link" aria-expanded="false" aria-controls="Mega-{{ section.id }}">{{ link.title }}</button>
                <div class="mega" id="Mega-{{ section.id }}" hidden>
                  <div class="mega__inner page-width">
                    {%- for block in section.blocks -%}
                      {%- case block.type -%}
                        {%- when 'column' -%}
                          <div class="mega__col" {{ block.shopify_attributes }}>
                            <p class="meta muted">{{ block.settings.heading }}</p>
                            <ul role="list">
                              {%- for l in linklists[block.settings.menu].links -%}
                                <li><a href="{{ l.url }}" class="mega__link">{{ l.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- when 'image' -%}
                          <a href="{{ block.settings.link | default: '#' }}" class="mega__feature zoom-hover" {{ block.shopify_attributes }}>
                            <div class="media ratio-4-5">{% render 'media-image', image: block.settings.image, sizes: '25vw', widths: '400, 600, 800' %}</div>
                            <span class="meta">{{ block.settings.label }}</span>
                            <span class="h3">{{ block.settings.title }}</span>
                          </a>
                      {%- endcase -%}
                    {%- endfor -%}
                  </div>
                </div>
              </li>
            {%- else -%}
              <li class="header__item"><a href="{{ link.url }}" class="header__link"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_style = 'width:' | append: section.settings.logo_width | append: 'px' -%}
        {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'header__logo-img', alt: shop.name, loading: 'eager', style: logo_style }}
      {%- else -%}
        <span class="wordmark header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="header__right">
      <button type="button" class="icon-btn" data-drawer-open="search" aria-label="{{ 'search.title' | t }}">{% render 'icon', name: 'search' %}</button>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-btn header__account" aria-label="{{ 'customer.account.title' | t }}">{% render 'icon', name: 'account' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__bag" data-drawer-open="cart" aria-label="{{ 'cart.title' | t }}">
        <span class="meta">{{ 'cart.title' | t }}</span>
        <span class="header__bag-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{%- comment -%} Mobile / full-screen menu {%- endcomment -%}
<div class="drawer drawer--left" id="MenuDrawer" data-drawer="menu" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel menu-drawer" tabindex="-1">
    <div class="drawer__head">
      <span class="wordmark">{{ shop.name }}</span>
      <button class="icon-btn" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer__body">
      <ul role="list" class="menu-drawer__links">
        {%- for link in linklists[section.settings.mobile_menu].links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details>
                <summary class="h3">{{ link.title }}</summary>
                <ul role="list" class="menu-drawer__sub">
                  {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="h3">{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- assign mood_menu = linklists[section.settings.mood_menu] -%}
      {%- if mood_menu.links.size > 0 -%}
        <p class="meta muted menu-drawer__label">{{ 'general.shop_by_mood' | t }}</p>
        <div class="menu-drawer__moods">
          {%- for link in mood_menu.links -%}
            {%- assign c = link.object -%}
            <a href="{{ link.url }}" class="menu-drawer__mood">
              <div class="media ratio-3-4">
                {%- if link.type == 'collection_link' and c.image -%}
                  {{ c.image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 400', sizes: '40vw', alt: c.title }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <span class="meta">{{ link.title }}</span>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="drawer__foot">
      <a href="{{ routes.account_url }}" class="link link--reveal">{{ 'customer.account.title' | t }}</a>
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" class="link link--reveal" target="_blank" rel="noopener">Instagram</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (leave empty to use wordmark)" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 260, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "Desktop menu", "default": "main-menu" },
    { "type": "text", "id": "mega_link_title", "label": "Menu item that opens the mega-menu", "default": "Shop" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile menu", "default": "main-menu" },
    { "type": "link_list", "id": "mood_menu", "label": "Mood tiles in mobile menu", "info": "Menu of the 5 mood collections. Tiles use each collection's image." },
    { "type": "checkbox", "id": "transparent_home", "label": "Transparent over homepage hero", "default": true }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Mega-menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "By Mood" },
        { "type": "link_list", "id": "menu", "label": "Links" }
      ]
    },
    {
      "type": "image",
      "name": "Mega-menu campaign tile",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Campaign" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Summer Edit" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
