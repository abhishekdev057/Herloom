{%- assign c = section.settings.collection -%}
<section class="section{% if section.settings.white_bg %} bg-white{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="meta muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: c.title }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ c.url | default: routes.all_products_collection_url }}" class="link">{{ section.settings.link_label }} <span class="arrow">→</span></a>
      {%- endif -%}
    </div>
    <div class="product-grid" style="--cols: {{ section.settings.columns }}">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.limit) -%}
          <div class="card">
            <div class="card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}<span class="card__badge badge badge--mto">{{ 'product.made_to_order' | t }}</span></div>
            <div class="card__row"><span class="card__title">{{ 'general.sample_product' | t }}</span><span class="card__price">₹ 6,900</span></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The first pieces" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "checkbox", "id": "white_bg", "label": "White background", "default": false }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
