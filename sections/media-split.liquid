{%- comment -%} Split media + text. Used for "Made for you. One piece at a time." (Atelier teaser) and anywhere else. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section split split--media-{{ s.media_side }}{% if s.bg == 'sand' %} bg-sand{% elsif s.bg == 'ink' %} bg-ink{% elsif s.bg == 'white' %} bg-white{% endif %}">
  <div class="page-width split__inner">
    <div class="split__media reveal">
      <div class="media ratio-{{ s.ratio }}">
        {%- if s.video != blank -%}
          <video muted loop playsinline autoplay preload="none" data-autoplay-video
            {% if s.image %}poster="{{ s.image | image_url: width: 1400 }}"{% endif %} aria-label="{{ s.heading | escape }}">
            {%- for source in s.video.sources -%}
              {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
            {%- endfor -%}
          </video>
        {%- else -%}
          {% render 'media-image', image: s.image, sizes: '(min-width: 1024px) 50vw, 100vw', placeholder: 'lifestyle-2' %}
        {%- endif -%}
      </div>
    </div>
    <div class="split__text">
      {%- if s.eyebrow != blank -%}<p class="meta{% if s.bg != 'ink' %} muted{% endif %} reveal">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="h1 reveal">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div class="lede reveal">{{ s.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ol class="split__points" role="list">
          {%- for block in section.blocks -%}
            <li class="reveal" {{ block.shopify_attributes }}>
              <span class="meta">0{{ forloop.index }}</span>
              <span class="split__point-title">{{ block.settings.title }}</span>
              {%- if block.settings.text != blank -%}<span class="split__point-text">{{ block.settings.text }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      {%- if s.link_label != blank -%}<a href="{{ s.link | default: '#' }}" class="link reveal">{{ s.link_label }} <span class="arrow">→</span></a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Media + text",
  "max_blocks": 5,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (or video poster)" },
    { "type": "video", "id": "video", "label": "Video (optional, short, muted loop)" },
    { "type": "select", "id": "ratio", "label": "Media ratio", "default": "4-5", "options": [ { "value": "4-5", "label": "4:5" }, { "value": "2-3", "label": "2:3" }, { "value": "1-1", "label": "Square" }, { "value": "16-9", "label": "16:9" } ] },
    { "type": "select", "id": "media_side", "label": "Media side", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "bg", "label": "Background", "default": "none", "options": [ { "value": "none", "label": "Ivory" }, { "value": "white", "label": "White" }, { "value": "sand", "label": "Sand" }, { "value": "ink", "label": "Ink" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for you. One piece at a time." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Nothing waits in a warehouse. Each shirt is cut and stitched by hand only after you order it.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Inside the Atelier" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Made to order" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{
    "name": "Media + text",
    "blocks": [
      { "type": "point", "settings": { "title": "Made to order", "text": "Cut only once you order." } },
      { "type": "point", "settings": { "title": "Handcrafted", "text": "Stitched by one maker, start to finish." } },
      { "type": "point", "settings": { "title": "Natural fabrics", "text": "Linen, cotton and silk that breathe." } },
      { "type": "point", "settings": { "title": "Fit-first", "text": "Your size, or your measurements." } }
    ]
  }]
}
{% endschema %}
