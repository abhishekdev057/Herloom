<section class="section makers">
  <div class="page-width">
    <div class="section-head"><div class="section-head__text">
      <p class="meta muted">{{ section.settings.eyebrow }}</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
    </div></div>
    <div class="makers__grid">
      {%- for block in section.blocks -%}
        <figure class="maker reveal" {{ block.shopify_attributes }}>
          <div class="media ratio-3-4">{% render 'media-image', image: block.settings.image, sizes: '(min-width: 1024px) 25vw, 50vw', alt: block.settings.name, placeholder: 'lifestyle-1', widths: '300, 500, 700' %}</div>
          <figcaption><span class="h3">{{ block.settings.name }}</span><span class="meta muted">{{ block.settings.role }}</span></figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meet the makers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The makers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The hands behind your shirt." }
  ],
  "blocks": [
    { "type": "maker", "name": "Maker", "settings": [
      { "type": "image_picker", "id": "image", "label": "Portrait" },
      { "type": "text", "id": "name", "label": "First name", "default": "Meera" },
      { "type": "text", "id": "role", "label": "Role", "default": "Master tailor · 18 years" }
    ] }
  ],
  "presets": [{ "name": "Meet the makers", "blocks": [ { "type": "maker" }, { "type": "maker" }, { "type": "maker" } ] }]
}
{% endschema %}
