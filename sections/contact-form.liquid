<section class="section contact">
  <div class="page-width contact__inner">
    <div>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      <div class="lede rte">{{ section.settings.text }}</div>
    </div>
    {%- form 'contact', class: 'contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success" role="status">{{ 'contact.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="ContactName">{{ 'contact.name' | t }}</label><input class="input" id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
      <div class="field"><label for="ContactEmail">{{ 'contact.email' | t }}</label><input class="input" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      <div class="field"><label for="ContactOrder">{{ 'contact.order' | t }}</label><input class="input" id="ContactOrder" name="contact[order_number]"></div>
      <div class="field"><label for="ContactMsg">{{ 'contact.message' | t }}</label><textarea class="textarea" id="ContactMsg" rows="6" name="contact[body]" required>{{ form.body }}</textarea></div>
      <button class="btn" type="submit">{{ 'contact.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Write to us." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about fit, fabric or an order in progress? We reply within a day.</p><p>hello@herloom.in · Instagram @herloom.in</p>" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
