<section class="section auth">
  <div class="page-width auth__inner">
    <h1 class="h1">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate', class: 'auth__form' -%}
      {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field"><label for="RegFirst">{{ 'customer.first_name' | t }}</label><input class="input" id="RegFirst" name="customer[first_name]" autocomplete="given-name"></div>
      <div class="field"><label for="RegLast">{{ 'customer.last_name' | t }}</label><input class="input" id="RegLast" name="customer[last_name]" autocomplete="family-name"></div>
      <div class="field"><label for="RegEmail">{{ 'customer.email' | t }}</label><input class="input" id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
      <div class="field"><label for="RegPass">{{ 'customer.password' | t }}</label><input class="input" id="RegPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <label class="filter-value"><input type="checkbox" name="customer[accepts_marketing]" value="true"> <span>{{ 'customer.register.marketing' | t }}</span></label>
      <button class="btn btn--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Register", "settings": [] }
{% endschema %}
