{%- comment -%}
  Order tracking landing page (/pages/track-order).
  Logged-in: lists recent orders with their live production stage.
  Guests: explain the stages + link to sign in or the order-status link in their email.
{%- endcomment -%}
<section class="section track">
  <div class="page-width track__inner">
    <div>
      <p class="meta muted">{{ section.settings.eyebrow }}</p>
      <h1 class="h1">{{ section.settings.heading }}</h1>
      <div class="lede rte">{{ section.settings.text }}</div>
    </div>
    <div>
      {%- if customer and customer.orders.size > 0 -%}
        {%- for order in customer.orders limit: 3 -%}
          <div class="track__order">
            <div class="card__row"><span class="h3">{{ order.name }}</span><a href="{{ order.customer_url }}" class="link">{{ 'customer.orders.details' | t }} <span class="arrow">→</span></a></div>
            {% render 'order-timeline', order: order %}
          </div>
        {%- endfor -%}
      {%- else -%}
        <ol class="timeline timeline--preview" role="list">
          {%- assign labels = 'timeline.received,timeline.cut,timeline.stitching,timeline.finishing,timeline.dispatched,timeline.delivered' | split: ',' -%}
          {%- for key in labels -%}
            <li class="timeline__step"><span class="timeline__dot" aria-hidden="true"></span><div class="timeline__text"><span class="timeline__label">{{ key | t }}</span></div></li>
          {%- endfor -%}
        </ol>
        <div class="track__cta">
          <a href="{{ routes.account_login_url }}" class="btn">{{ 'customer.login.title' | t }}</a>
          <p class="meta muted">{{ 'timeline.guest_help' | t }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Order tracking",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow your shirt." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every Herloom shirt is made after you order. Watch it move from our cutting table to your door.</p>" }
  ],
  "presets": [{ "name": "Order tracking" }]
}
{% endschema %}
