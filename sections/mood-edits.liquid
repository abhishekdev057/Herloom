{%- comment -%} The 5 moods. Desktop: staggered editorial grid. Mobile: swipe cards. {%- endcomment -%}
<section class="section moods">
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="meta muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h1">{{ section.settings.heading }}</h2>
      </div>
    </div>
  </div>
  <div class="moods__track scroller" data-scroller>
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign img = block.settings.image | default: c.image
        assign title = block.settings.title | default: c.title
        assign title_handle = title | handle
        assign fallback_url = routes.collections_url | append: '/' | append: title_handle
        assign url = c.url | default: fallback_url
      -%}
      <a href="{{ url }}" class="mood-tile mood-tile--{{ forloop.index }} reveal zoom-hover" {{ block.shopify_attributes }}>
        <div class="media ratio-3-4">
          {% render 'media-image', image: img, sizes: '(min-width: 1024px) 30vw, 72vw', alt: title, placeholder: 'lifestyle-2', widths: '400, 600, 800, 1100' %}
        </div>
        <div class="mood-tile__text">
          <span class="meta muted">0{{ forloop.index }}</span>
          <h3 class="h3">{{ title }}</h3>
          <p class="mood-tile__desc">{{ block.settings.description }}</p>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Mood edits",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by mood" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A shirt for every mood." }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (defaults to collection image)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "description", "label": "One-line description" }
      ]
    }
  ],
  "presets": [{
    "name": "Mood edits",
    "blocks": [
      { "type": "mood", "settings": { "title": "Casual", "description": "For coffee runs, errands and slow weekends." } },
      { "type": "mood", "settings": { "title": "Smart Casual", "description": "Polished enough for the boardroom, easy enough for lunch." } },
      { "type": "mood", "settings": { "title": "Resort", "description": "For slow mornings and sunlit getaways." } },
      { "type": "mood", "settings": { "title": "Party & Evening", "description": "Fluid fabrics for dinners and late nights." } },
      { "type": "mood", "settings": { "title": "Statement", "description": "Elevated pieces for dressing up." } }
    ]
  }]
}
{% endschema %}
