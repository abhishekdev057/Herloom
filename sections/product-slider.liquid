{%- assign c = section.settings.collection -%}
<section class="section slider-section" data-slider>
  <div class="page-width">
    <div class="section-head">
      <div class="section-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="meta muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | default: c.title }}</h2>
      </div>
      <div class="section-head__actions">
        <div class="scroller-nav">
          <button type="button" data-scroll-prev aria-label="{{ 'accessibility.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" data-scroll-next aria-label="{{ 'accessibility.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
        {%- if section.settings.link_label != blank -%}<a href="{{ c.url | default: routes.all_products_collection_url }}" class="link">{{ section.settings.link_label }} <span class="arrow">→</span></a>{%- endif -%}
      </div>
    </div>
  </div>
  <div class="scroller" data-scroller tabindex="0" aria-label="{{ section.settings.heading | escape }}">
    {%- if c != blank and c.products_count > 0 -%}
      {%- for product in c.products limit: section.settings.limit -%}
        {% render 'product-card', product: product, sizes: '(min-width: 1024px) 25vw, 72vw' %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}
        <div class="card"><div class="card__media">{{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}</div><span class="card__title">{{ 'general.sample_product' | t }}</span></div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product slider",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Signature pieces" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Signature Shirt" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 1, "default": 10 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop bestsellers" }
  ],
  "presets": [{ "name": "Product slider" }]
}
{% endschema %}
