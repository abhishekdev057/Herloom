<footer class="footer{% if section.settings.dark %} bg-ink{% endif %}">
  <div class="page-width footer__top">
    <div class="footer__news">
      <p class="h3">{{ section.settings.newsletter_heading }}</p>
      {% render 'newsletter-form', form_id: 'FooterNewsletter', dark: section.settings.dark %}
    </div>
    <div class="footer__cols">
      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          <p class="meta muted">{{ block.settings.heading }}</p>
          <ul role="list">
            {%- for link in linklists[block.settings.menu].links -%}
              <li><a href="{{ link.url }}" class="link--reveal link footer__link">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
      <div class="footer__col">
        <p class="meta muted">{{ 'general.social' | t }}</p>
        <ul role="list">
          {%- if settings.social_instagram != blank -%}
            <li><a href="{{ settings.social_instagram }}" class="link link--reveal footer__link" target="_blank" rel="noopener">Instagram</a></li>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <li><a href="{{ settings.social_pinterest }}" class="link link--reveal footer__link" target="_blank" rel="noopener">Pinterest</a></li>
          {%- endif -%}
          {%- if settings.contact_whatsapp != blank -%}
            <li><a href="https://wa.me/{{ settings.contact_whatsapp | remove: '+' | remove: ' ' }}" class="link link--reveal footer__link" target="_blank" rel="noopener">WhatsApp</a></li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>

  <div class="page-width footer__meta">
    {%- if localization.available_countries.size > 1 -%}
      {%- form 'localization', class: 'footer__locale' -%}
        <label for="FooterCountry" class="visually-hidden">{{ 'general.region' | t }}</label>
        <select id="FooterCountry" name="country_code" class="select" onchange="this.form.submit()">
          {%- for c in localization.available_countries -%}
            <option value="{{ c.iso_code }}" {% if c.iso_code == localization.country.iso_code %}selected{% endif %}>{{ c.name }} ({{ c.currency.iso_code }} {{ c.currency.symbol }})</option>
          {%- endfor -%}
        </select>
      {%- endform -%}
    {%- endif -%}
    {%- if section.settings.show_payment_icons -%}
      <ul class="footer__payments" role="list">
        {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
      </ul>
    {%- endif -%}
    <p class="meta muted">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</p>
  </div>

  <div class="footer__wordmark" aria-hidden="true"><span class="wordmark">{{ shop.name }}</span></div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "dark", "label": "Ink background", "default": false },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Be the first to see new pieces." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "Handmade in India, one piece at a time." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ]
}
{% endschema %}
