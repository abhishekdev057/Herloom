<section class="section account">
  <div class="page-width">
    <a href="{{ routes.account_url }}" class="link link--reveal">← {{ 'customer.account.title' | t }}</a>
    <h1 class="h1" style="margin:24px 0 48px">{{ 'customer.addresses.title' | t }}</h1>
    <div class="account__grid">
      <div>
        {%- for address in customer.addresses -%}
          <div class="address-card">
            {%- if address == customer.default_address -%}<span class="badge badge--outline">{{ 'customer.addresses.default' | t }}</span>{%- endif -%}
            <p>{{ address | format_address }}</p>
            <details>
              <summary class="link link--reveal">{{ 'customer.addresses.edit' | t }}</summary>
              {%- form 'customer_address', address, class: 'auth__form' -%}
                {% render 'address-fields', form: form, id: address.id %}
                <button class="btn">{{ 'customer.addresses.save' | t }}</button>
              {%- endform -%}
            </details>
            <form method="post" action="/account/addresses/{{ address.id }}" onsubmit="return confirm('{{ 'customer.addresses.delete_confirm' | t }}')">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="link link--reveal muted">{{ 'customer.addresses.delete' | t }}</button>
            </form>
          </div>
        {%- endfor -%}
      </div>
      <div>
        <h2 class="meta">{{ 'customer.addresses.add' | t }}</h2>
        {%- form 'customer_address', customer.new_address, class: 'auth__form' -%}
          {% render 'address-fields', form: form, id: 'new' %}
          <button class="btn">{{ 'customer.addresses.add' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Addresses", "settings": [] }
{% endschema %}
