<section class="section search-page">
  <div class="page-width">
    <h1 class="h1">{% if search.performed %}{{ 'search.results_for' | t: terms: search.terms }}{% else %}{{ 'search.title' | t }}{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form search-page__form">
      <input type="hidden" name="type" value="product">
      <label for="SearchPageInput" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
      <input id="SearchPageInput" class="search-form__input h3" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="link">{{ 'search.submit' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <p class="meta muted">{{ 'collection.count' | t: count: search.results_count }}</p>
          <div class="product-grid" style="--cols: 4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.next -%}<div class="plp__more"><a href="{{ paginate.next.url }}" class="btn btn--outline">{{ 'collection.load_more' | t }}</a></div>{%- endif -%}
        {%- else -%}
          <div class="empty">
            <p class="h3">{{ 'search.empty_title' | t }}</p>
            <p class="muted">{{ 'search.empty_text' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">{{ 'cart.empty_cta' | t }}</a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
