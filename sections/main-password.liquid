<section class="hero hero--full hero--align-center password">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', alt: '' , class: 'hero__poster' }}
    {%- endif -%}
    <div class="hero__scrim" style="--scrim:.35"></div>
  </div>
  <div class="hero__content page-width">
    <h1 class="display hero__heading">{{ shop.name }}</h1>
    <p class="hero__sub">{{ section.settings.text }}</p>
    <div style="width:min(420px,100%)">{% render 'newsletter-form', form_id: 'PasswordNewsletter' %}</div>
    <details>
      <summary class="link">Enter with password</summary>
      {%- form 'storefront_password', class: 'newsletter-form' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="newsletter-form__row">
          <label for="Password" class="visually-hidden">Password</label>
          <input class="input input--line" type="password" name="password" id="Password" autocomplete="current-password" placeholder="Password">
          <button class="link" type="submit">Enter</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "text", "label": "Text", "default": "Shirts, perfected. Opening soon." }
  ]
}
{% endschema %}
