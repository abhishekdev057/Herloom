{%- comment -%}
  PLP. Reused for moods, styles, fabrics and edits — they are all collections.
  Filters use Shopify Search & Discovery (storefront filtering). Enable filters for
  metafields custom.moods, custom.fabric, Size, Colour, Price in the Search & Discovery app.
  Load more: theme.js fetches the next page and appends [data-grid-item] nodes.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign per_page = s.per_page
  assign banner = collection.metafields.custom.banner.value | default: collection.image
-%}
<div class="plp" data-plp data-section-id="{{ section.id }}">
  <header class="plp__head page-width{% if s.show_banner and banner %} plp__head--banner{% endif %}">
    <div class="plp__title">
      <nav class="breadcrumbs meta" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title }}</span></nav>
      <h1 class="h1">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="lede muted">{{ collection.description | strip_html | truncatewords: 30 }}</div>{%- endif -%}
    </div>
    {%- if s.show_banner and banner -%}
      <div class="plp__banner media ratio-21-9">
        {%- assign banner_alt = collection.title | escape -%}
        {{ banner | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: banner_alt }}
      </div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by per_page -%}
    <div class="plp__toolbar" data-plp-toolbar>
      <div class="page-width plp__toolbar-inner">
        <button type="button" class="link link--reveal" data-drawer-open="filters" aria-controls="FilterDrawer">
          {% render 'icon', name: 'filter' %} {{ 'collection.filter' | t }}
          {%- assign active_count = 0 -%}
          {%- for f in collection.filters -%}{%- assign active_count = active_count | plus: f.active_values.size -%}{%- endfor -%}
          {%- if active_count > 0 -%}<span>({{ active_count }})</span>{%- endif -%}
        </button>
        <p class="meta muted" data-plp-count>{{ 'collection.count' | t: count: collection.products_count }}</p>
        <div class="plp__toolbar-right">
          <label class="visually-hidden" for="SortBy">{{ 'collection.sort' | t }}</label>
          <select id="SortBy" class="plp__sort meta" data-plp-sort>
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
          <div class="plp__cols" role="group" aria-label="{{ 'collection.grid' | t }}">
            <button type="button" class="meta plp__col-btn plp__col-btn--m" data-cols="1" aria-pressed="false">1</button>
            <button type="button" class="meta plp__col-btn plp__col-btn--m" data-cols="2" aria-pressed="true">2</button>
            <button type="button" class="meta plp__col-btn plp__col-btn--d" data-cols="2" aria-pressed="false">2</button>
            <button type="button" class="meta plp__col-btn plp__col-btn--d" data-cols="3" aria-pressed="false">3</button>
            <button type="button" class="meta plp__col-btn plp__col-btn--d" data-cols="4" aria-pressed="true">4</button>
          </div>
        </div>
      </div>
    </div>

    <div class="page-width plp__body">
      {%- if collection.products.size > 0 -%}
        <div class="product-grid plp__grid" style="--cols: 4" data-plp-grid data-mobile-cols="2">
          {%- assign offset = paginate.current_offset -%}
          {%- for product in collection.products -%}
            {%- assign pos = offset | plus: forloop.index -%}
            <div class="plp__cell" data-grid-item>{% render 'product-card', product: product, eager: forloop.first %}</div>
            {%- for block in section.blocks -%}
              {%- if block.settings.position == pos -%}
                <div class="plp__editorial plp__editorial--{{ block.settings.layout }}" data-grid-item {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link | default: '#' }}" class="plp__editorial-link zoom-hover">
                    <div class="media {% if block.settings.layout == 'full' %}ratio-21-9{% else %}ratio-4-5{% endif %}">
                      {% render 'media-image', image: block.settings.image, sizes: '100vw', placeholder: 'lifestyle-1' %}
                      <div class="hero__scrim" style="--scrim:.3"></div>
                    </div>
                    <div class="plp__editorial-text">
                      <span class="meta">{{ block.settings.eyebrow }}</span>
                      <span class="h2">{{ block.settings.heading }}</span>
                      {%- if block.settings.link_label != blank -%}<span class="link">{{ block.settings.link_label }} <span class="arrow">→</span></span>{%- endif -%}
                    </div>
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        {%- if paginate.next -%}
          <div class="plp__more">
            {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
            <p class="meta muted">{{ 'collection.showing' | t: shown: shown, total: paginate.items }}</p>
            <a href="{{ paginate.next.url }}" class="btn btn--outline" data-load-more>{{ 'collection.load_more' | t }}</a>
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="empty">
          <p class="h3">{{ 'collection.empty_title' | t }}</p>
          <p class="muted">{{ 'collection.empty_text' | t }}</p>
          <a href="{{ collection.url }}" class="btn btn--outline">{{ 'collection.clear' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  {%- endpaginate -%}

  {%- comment -%} Filter drawer (side on desktop, bottom sheet on mobile) {%- endcomment -%}
  <div class="drawer drawer--left drawer--sheet" id="FilterDrawer" data-drawer="filters" role="dialog" aria-modal="true" aria-labelledby="FilterTitle" aria-hidden="true">
    <div class="drawer__overlay" data-drawer-close></div>
    <form class="drawer__panel" tabindex="-1" data-filter-form action="{{ collection.url }}">
      <input type="hidden" name="sort_by" value="{{ collection.sort_by | default: collection.default_sort_by }}">
      <div class="drawer__head">
        <h2 id="FilterTitle" class="meta">{{ 'collection.filter' | t }}</h2>
        <button class="icon-btn" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>
      <div class="drawer__body accordion">
        {%- for filter in collection.filters -%}
          <details {% if forloop.index <= 2 or filter.active_values.size > 0 %}open{% endif %}>
            <summary>{{ filter.label }}<span class="plus" aria-hidden="true"></span></summary>
            <div class="accordion__body">
              {%- case filter.type -%}
                {%- when 'price_range' -%}
                  <div class="filter-price">
                    <div class="field"><label for="Price-min">{{ 'collection.from' | t }} ({{ cart.currency.symbol }})</label>
                      <input class="input" id="Price-min" type="number" inputmode="numeric" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="0"></div>
                    <div class="field"><label for="Price-max">{{ 'collection.to' | t }} ({{ cart.currency.symbol }})</label>
                      <input class="input" id="Price-max" type="number" inputmode="numeric" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}"></div>
                  </div>
                {%- else -%}
                  <ul class="filter-values{% if filter.presentation == 'swatch' %} filter-values--swatch{% endif %}" role="list">
                    {%- for value in filter.values -%}
                      <li>
                        <label class="filter-value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                          {%- if value.swatch.color -%}<span class="swatch" style="--swatch: {{ value.swatch.color }}"></span>{%- endif -%}
                          <span>{{ value.label }}</span>
                          <span class="muted">({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
              {%- endcase -%}
            </div>
          </details>
        {%- else -%}
          <p class="muted">{{ 'collection.no_filters' | t }}</p>
        {%- endfor -%}
      </div>
      <div class="drawer__foot plp__filter-foot">
        <a href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}" class="btn btn--outline">{{ 'collection.clear' | t }}</a>
        <button type="submit" class="btn">{{ 'collection.apply' | t }}</button>
      </div>
    </form>
  </div>
</div>

{% schema %}
{
  "name": "Product listing",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per load", "min": 12, "max": 36, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_banner", "label": "Show collection banner image", "default": true }
  ],
  "blocks": [
    {
      "type": "editorial",
      "name": "Editorial insert",
      "settings": [
        { "type": "range", "id": "position", "label": "Show after product #", "min": 4, "max": 48, "step": 1, "default": 8 },
        { "type": "select", "id": "layout", "label": "Layout", "default": "full", "options": [ { "value": "full", "label": "Full width" }, { "value": "double", "label": "Two-column tile" } ] },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the look" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "From coffee to cocktails." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
