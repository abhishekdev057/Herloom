{%- assign s = section.settings -%}
<section class="banner banner--{{ s.height }}">
  <div class="banner__media media">
    {%- if s.video != blank -%}
      <video muted loop playsinline autoplay preload="none" data-autoplay-video {% if s.image %}poster="{{ s.image | image_url: width: 1920 }}"{% endif %} aria-hidden="true">
        {%- for source in s.video.sources -%}{%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}{%- endfor -%}
      </video>
    {%- else -%}
      {% render 'media-image', image: s.image, eager: s.eager, sizes: '100vw', placeholder: 'lifestyle-1' %}
    {%- endif -%}
    <div class="hero__scrim" style="--scrim: {{ s.scrim | divided_by: 100.0 }}"></div>
  </div>
  {%- if s.heading != blank or s.eyebrow != blank -%}
    <div class="banner__content page-width">
      {%- if s.eyebrow != blank -%}<p class="meta">{{ s.eyebrow }}</p>{%- endif -%}
      {%- if s.as_h1 -%}<h1 class="display banner__title">{{ s.heading }}</h1>{%- else -%}<h2 class="h1 banner__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="lede">{{ s.text }}</p>{%- endif -%}
      {%- if s.link_label != blank -%}<a href="{{ s.link | default: '#' }}" class="btn btn--light">{{ s.link_label }}</a>{%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Full-bleed banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video (optional)" },
    { "type": "select", "id": "height", "label": "Height", "default": "large", "options": [ { "value": "full", "label": "Full screen" }, { "value": "large", "label": "Large (21:9 desktop)" }, { "value": "medium", "label": "Medium" } ] },
    { "type": "range", "id": "scrim", "label": "Scrim", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 25 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "as_h1", "label": "Use as page H1 (top of page only)", "default": false },
    { "type": "checkbox", "id": "eager", "label": "Load immediately (top of page only)", "default": false },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Button link" }
  ],
  "presets": [{ "name": "Full-bleed banner" }]
}
{% endschema %}
