<section class="section intro intro--{{ section.settings.layout }}">
  <div class="page-width intro__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="meta muted reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="h1 intro__title reveal">{{ section.settings.heading }}</h2>
    <div class="intro__body reveal">
      {%- if section.settings.text != blank -%}<div class="lede">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="link">{{ section.settings.link_label }} <span class="arrow">→</span></a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collection 01" },
    { "type": "richtext", "id": "text", "label": "Text (max ~20 words)", "default": "<p>Breathable linens and fluid silks, cut and stitched by hand, one piece at a time.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the collection" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [ { "value": "split", "label": "Offset (editorial)" }, { "value": "center", "label": "Centred" } ] }
  ],
  "presets": [{ "name": "Collection intro" }]
}
{% endschema %}
