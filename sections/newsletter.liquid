<section class="section newsletter{% if section.settings.bg == 'sand' %} bg-sand{% endif %}">
  <div class="page-width newsletter__inner">
    <h2 class="h2 reveal">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="muted reveal">{{ section.settings.text }}</p>{%- endif -%}
    <div class="reveal newsletter__form">{% render 'newsletter-form', form_id: 'SectionNewsletter' %}</div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be the first to see new pieces." },
    { "type": "text", "id": "text", "label": "Text", "default": "New collections, atelier notes. Never more than twice a month." },
    { "type": "select", "id": "bg", "label": "Background", "default": "sand", "options": [ { "value": "none", "label": "Ivory" }, { "value": "sand", "label": "Sand" } ] }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
