{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} gift card</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="section"><div class="page-width empty">
    <p class="wordmark">{{ shop.name }}</p>
    <h1 class="h1">{{ gift_card.balance | money }}</h1>
    {%- if gift_card.expired or gift_card.enabled == false -%}<p class="muted">This gift card is no longer valid.</p>{%- endif -%}
    <p class="meta">Code</p><p class="h3">{{ gift_card.code | format_code }}</p>
    <a href="{{ shop.url }}" class="btn">Shop now</a>
  </div></main>
</body>
</html>
