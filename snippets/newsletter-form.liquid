{%- comment -%} Params: form_id, dark {%- endcomment -%}
{%- form 'customer', id: form_id, class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  {%- if form.posted_successfully? -%}
    <p class="form-success" role="status">{{ 'newsletter.success' | t }}</p>
  {%- else -%}
    <div class="newsletter-form__row">
      <label for="{{ form_id }}-email" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
      <input id="{{ form_id }}-email" type="email" name="contact[email]" class="input input--line" placeholder="{{ 'newsletter.label' | t }}" autocomplete="email" required
        {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}>
      <button type="submit" class="link">{{ 'newsletter.button' | t }} <span class="arrow">→</span></button>
    </div>
    {%- if form.errors -%}<p id="{{ form_id }}-error" class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
  {%- endif -%}
{%- endform -%}
