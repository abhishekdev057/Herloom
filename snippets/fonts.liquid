{%- comment -%}
  Fonts. Default: Instrument Serif (display) + Manrope (UI) from Google Fonts.
  To self-host licensed fonts (Canela, Neue Haas…), upload .woff2 files to
  /assets and switch "Font source" to "Self-hosted" in Theme settings → Typography.
{%- endcomment -%}
{%- if settings.font_source == 'self' -%}
  {%- if settings.font_display_file != blank -%}
    <link rel="preload" href="{{ settings.font_display_file | asset_url }}" as="font" type="font/woff2" crossorigin>
  {%- endif -%}
  <style>
    {%- if settings.font_display_file != blank -%}
    @font-face { font-family: 'Herloom Display'; src: url('{{ settings.font_display_file | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
    {%- endif -%}
    {%- if settings.font_body_file != blank -%}
    @font-face { font-family: 'Herloom Sans'; src: url('{{ settings.font_body_file | asset_url }}') format('woff2'); font-weight: 300 700; font-display: swap; }
    {%- endif -%}
  </style>
{%- else -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@300;400;500;600&display=swap">
{%- endif -%}
