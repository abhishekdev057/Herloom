{%- comment -%} Structured data: Organization (home), Product + Breadcrumb (PDP), Breadcrumb (collection). {%- endcomment -%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }},
    {%- if settings.logo != blank %}"logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{% endif %}
    "sameAs": [{% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}]
  }
</script>
{%- elsif request.page_type == 'product' -%}
<script type="application/ld+json">
  {{ product | structured_data }}
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
      {%- if collection -%}
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: request.origin | json }} },
      { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ product.url | prepend: request.origin | json }} }
      {%- else -%}
      { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ product.url | prepend: request.origin | json }} }
      {%- endif -%}
    ]
  }
</script>
{%- elsif request.page_type == 'collection' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | prepend: request.origin | json }} }
    ]
  }
</script>
{%- endif -%}
