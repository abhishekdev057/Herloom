{%- if cart.item_count > 0 -%}
  <div class="drawer__body">
    <ul class="cart-lines" role="list">
      {%- for item in cart.items -%}
        {% render 'cart-line', item: item, index: forloop.index %}
      {%- endfor -%}
    </ul>
  </div>
  <div class="drawer__foot">
    <p class="cart-leadtime meta"><span class="badge badge--mto">{{ 'product.made_to_order' | t }}</span> {{ 'cart.lead_time' | t: days: settings.default_lead_time }}</p>
    <div class="card__row">
      <span class="meta">{{ 'cart.subtotal' | t }}</span>
      <span>{{ cart.total_price | money_with_currency }}</span>
    </div>
    <p class="meta muted">{{ 'cart.taxes_shipping' | t }}</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn--full">{{ 'cart.checkout' | t }}</button>
    </form>
    <a href="{{ routes.cart_url }}" class="link" style="justify-self:center">{{ 'cart.view_bag' | t }}</a>
  </div>
{%- else -%}
  <div class="drawer__body">
    <div class="empty">
      <p class="h3">{{ 'cart.empty_title' | t }}</p>
      <p class="muted">{{ 'cart.empty_text' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">{{ 'cart.empty_cta' | t }}</a>
    </div>
  </div>
{%- endif -%}
